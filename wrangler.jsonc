{
  // Enquire · enquire.nexus — one engine behind enquire.nexus and its editions.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enquire-nexus",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The site: everything in /public, with the engine answering /api/* and /health first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },

  // Approved sources that live in this account. Both databases are EU-jurisdiction.
  // The engine only ever SELECTs from them. The VO / OCVO registers are deliberately not bound.
  "d1_databases": [
    { "binding": "EVIDENCE_DB", "database_name": "tpn-evidence", "database_id": "1a66ea0c-1b3d-48a3-ba6a-3117908fe7bd" },
    { "binding": "CT_DB", "database_name": "ct-corporate-sources", "database_id": "4ee65a54-755e-4a4e-b1ae-a99052cce319" },
    // Enquire's own database (EU): the daily copy of the ThinkPeople sites' published pages
    { "binding": "ENQUIRE_DB", "database_name": "enquire-nexus", "database_id": "6e88275f-5a54-45da-bd71-bed4698e1389" }
  ],

  // every day at 04:41 Malta time: re-read the published pages
  "triggers": { "crons": ["41 3 * * *"] },

  // At most 12 fresh enquiries a minute from one visitor (answers already cached do not count).
  "ratelimits": [
    { "name": "ENQUIRE_LIMIT", "namespace_id": "4410", "simple": { "limit": 12, "period": 60 } }
  ],

  "vars": { "CLAUDE_MODEL": "claude-sonnet-5-5" }
  // Secret, set in the Cloudflare dashboard: ANTHROPIC_API_KEY
}
